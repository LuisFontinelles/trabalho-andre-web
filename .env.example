# Copie para .env.local. Sem VITE_API_URL o app roda inteiro com o backend de
# fixtures. Com /api, login e cadastro do profissional vao para a API real
# pelo proxy do Vite (npm run dev); o restante continua no mock.
VITE_API_URL=/api

# Opcional: outro destino para o proxy, por exemplo a API rodando localmente.
# API_PROXY_TARGET=http://localhost:8080
